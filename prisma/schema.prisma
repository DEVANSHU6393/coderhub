generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String
  date             String
  time             String
  venue            String
  imageUrl         String?
  registrationLink String?
  createdAt        DateTime @default(now())
}

model Application {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String
  year        String
  branch      String
  skills      String[]
  interests   String[]
  githubUrl   String?
  linkedinUrl String?
  reason      String
  experience  String   @default("beginner")
  source      String   @default("other")
  status      String   @default("pending") // "pending", "accepted", "rejected"
  createdAt   DateTime @default(now())
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  category  String   // e.g., "Notes", "Previous Year Papers"
  subject   String   // e.g., "Data Structures", "Operating Systems"
  link      String   // URL to Google Drive or PDF
  createdAt DateTime @default(now())
}

model Test {
  id          String     @id @default(cuid())
  title       String
  description String
  subject     String
  questions   Question[]
  createdAt   DateTime   @default(now())
}

model Question {
  id           String @id @default(cuid())
  testId       String
  test         Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  text         String
  options      String[] // Array of strings for the multiple choices
  correctIndex Int      // Index of the correct option (0, 1, 2, or 3)
}
